{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exo-robotics.github.io/Robot-3D-Sim/schemas/observation.schema.json",
  "title": "EXO observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "base", "imu", "joints", "contacts", "task"],
  "properties": {
    "timestamp": { "type": "number", "minimum": 0 },
    "base": {
      "type": "object",
      "required": ["orientation", "linear_velocity", "angular_velocity"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "orientation": { "$ref": "#/$defs/quaternion" },
        "linear_velocity": { "$ref": "#/$defs/vec3" },
        "angular_velocity": { "$ref": "#/$defs/vec3" }
      }
    },
    "imu": { "type": "object" },
    "joints": { "type": "array" },
    "contacts": { "type": "object" },
    "task": { "type": "object" },
    "perception": { "type": "object" }
  },
  "$defs": {
    "vec3": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "items": false },
    "quaternion": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}], "items": false }
  }
}
