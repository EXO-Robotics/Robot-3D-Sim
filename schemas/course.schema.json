{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exo-robotics.github.io/Robot-3D-Sim/schemas/course.schema.json",
  "title": "EXO course v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "course_id", "version", "name", "task", "limits", "command", "success"],
  "properties": {
    "schema_version": { "const": "exo.course.v1" },
    "course_id": { "pattern": "^[A-Z]+-[0-9]{3}$" },
    "version": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string" },
    "task": { "enum": ["stand", "walk", "walk_stop", "turn_walk_stop"] },
    "limits": { "type": "object" },
    "command": { "type": "object" },
    "success": { "type": "object" }
  }
}
