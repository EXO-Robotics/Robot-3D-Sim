{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exo-robotics.github.io/Robot-3D-Sim/schemas/motor-command.schema.json",
  "title": "EXO motor command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["q_des", "dq_des", "kp", "kd", "tau_ff"],
  "properties": {
    "q_des": { "$ref": "#/$defs/vector" },
    "dq_des": { "$ref": "#/$defs/vector" },
    "kp": { "$ref": "#/$defs/vector" },
    "kd": { "$ref": "#/$defs/vector" },
    "tau_ff": { "$ref": "#/$defs/vector" }
  },
  "$defs": {
    "vector": {
      "type": "array",
      "items": { "type": "number" }
    }
  }
}
