{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exo-robotics.github.io/Robot-3D-Sim/schemas/exorun-manifest.schema.json",
  "title": "EXO run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "robot", "controller", "course", "engine", "exo_bench", "environment", "seed", "reset_profile", "sensor_profile", "runner", "determinism", "determinism_digest", "contents"],
  "properties": {
    "schema_version": { "const": "exo.run.v1" },
    "robot": { "type": "object" },
    "controller": { "type": "object" },
    "course": { "type": "object" },
    "engine": { "type": "object" },
    "exo_bench": { "type": "object" },
    "environment": { "type": "object" },
    "seed": { "type": "integer" },
    "reset_profile": { "type": "object" },
    "sensor_profile": { "type": "string" },
    "runner": { "type": "object" },
    "determinism": { "type": "object" },
    "determinism_digest": { "pattern": "^[a-f0-9]{64}$" },
    "contents": { "type": "object", "additionalProperties": { "pattern": "^[a-f0-9]{64}$" } }
  }
}
